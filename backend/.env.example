APP_NAME=Wellbeing Hub API
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wellbeing_hub
USE_ML_RISK_SCORING=false
EXPOSE_ML_RISK_METRICS=false
CORS_ALLOW_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# APP_VERSION=1.0.0
# Optional: protect /api/admin/* (header X-Admin-Key). Leave unset to hide admin routes (404).
# ADMIN_API_KEY=
